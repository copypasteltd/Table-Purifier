<b-frame variant=""><view tt:if="{{loading}}" class="notice">正在处理，请稍候……</view><view tt:if="{{error}}" class="error">{{error}}<button class="button" data-action="refresh" bindtap="onAction">重新读取状态</button></view><b-message text="{{notice}}"/><b-heading title="整理结果"/><b-status title="{{run.quality_status==='PASSED'?'内容已通过验收':'内容仍需确认'}}" text="执行：{{run.execution_status==='SUCCEEDED'?'已完成':'待完成'}} · 结果版本 {{run.result_version}}"/>
<view tt:if="{{counts}}" class="section"><view>总候选 {{counts.total_candidates}} 条</view><view>通过 {{counts.accepted}} · 待确认 {{counts.needs_review}} · 已排除 {{counts.excluded}}</view><view class="small">总候选始终与三类去向相等；空值“—”不代表零。</view></view>
<b-record tt:for="{{records}}" tt:key="record_id" title="记录 {{item.ordinal+1}}" text="{{item.disposition==='ACCEPTED'?'通过':item.disposition==='EXCLUDED'?'已排除':'待确认'}}"><view tt:for="{{expandedRecord===item.record_id?item.values:item.keyValues}}" tt:for-item="value" tt:key="id" class="field-row"><text class="field-label">{{value.label}}</text><text class="field-value">{{value.value}}</text></view><button tt:if="{{item.moreFields}}" class="text-button" data-action="toggle-record" data-id="{{item.record_id}}" bindtap="onAction">{{expandedRecord===item.record_id?'收起更多字段':'查看全部字段'}}</button></b-record>
<button tt:if="{{nextCursor}}" class="button" data-action="load-more" bindtap="onAction" disabled="{{loading}}">加载下一页记录</button>
<b-actions><button class="button primary" data-action="go-MP12" bindtap="onAction">领取完整结果文件</button><button class="button" data-action="go-MP09" bindtap="onAction">查看问题与待确认项</button></b-actions>
<b-feedback title="原资料已有内容，但整理出现遗漏或错误" text="先建立新会话并重传必要原件。重新确认方案和估费，售后核实后使用原实付权益纠错，不重复收款。"><button class="button" data-action="prepare-correction" bindtap="onAction" disabled="{{loading}}">发起原单纠错</button></b-feedback>
</b-frame>
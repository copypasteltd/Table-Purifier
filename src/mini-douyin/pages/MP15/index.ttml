<b-frame><view tt:if="{{loading}}" class="notice">正在处理，请稍候……</view><view tt:if="{{error}}" class="error">{{error}}<button class="button" data-action="refresh" bindtap="onAction">重新读取状态</button></view><b-message text="{{notice}}"/><view class="hero">我的资料，<view>有清楚的去向。</view></view>
<b-status title="当前平台账号" text="按当前支付宝或抖音身份访问自己的资料，不要求头像或手机号。"/>
<b-heading title="订单与售后"/><b-order tt:for="{{orders}}" tt:key="order_id" title="资料成表服务" text="{{item.amount.amount_minor}} {{item.amount.amount_unit==='CNY_FEN'?'人民币分':'抖音钻石'}}"><button class="button" data-action="view-order" data-id="{{item.order_id}}" bindtap="onAction">查看原订单</button></b-order>
<button tt:if="{{nextCursor}}" class="button" data-action="load-more" bindtap="onAction" disabled="{{loading}}">加载下一页订单</button>
<button class="button" data-action="go-MP17" bindtap="onAction">隐私与数据管理</button><button class="button" data-action="go-MP18" bindtap="onAction">帮助与售后</button>
</b-frame><b-navigation><view class="nav-button " data-action="go-MP01" bindtap="onAction">整理</view><view class="nav-button " data-action="go-MP13" bindtap="onAction">任务</view><view class="nav-button " data-action="go-MP14" bindtap="onAction">规范</view><view class="nav-button nav-current" data-action="go-MP15" bindtap="onAction">我的</view></b-navigation>
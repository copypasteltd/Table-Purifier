<b-frame variant="page-root"><view tt:if="{{loading}}" class="notice">正在处理，请稍候……</view><view tt:if="{{error}}" class="error">{{error}}<button class="button" data-action="refresh" bindtap="onAction">重新读取状态</button></view><b-message text="{{notice}}"/><b-heading title="我的整理任务"/>
<b-feedback tt:if="{{!tasks.length}}" title="还没有整理任务" text="新建会话，提交零散资料，从推荐规范开始。"/>
<b-task tt:for="{{tasks}}" tt:key="task_id" title="{{item.goal||'资料成表任务'}}" text="{{item.current_result_version?'已有结果，可查看和再次领取':'点击读取最新任务状态'}}"><button class="button" data-action="view-task" data-id="{{item.task_id}}" bindtap="onAction">继续此任务</button></b-task>
<button tt:if="{{nextCursor}}" class="button" data-action="load-more" bindtap="onAction" disabled="{{loading}}">加载下一页任务</button>
<button class="button primary" data-action="go-MP01" bindtap="onAction">新建整理</button>
</b-frame><b-navigation><button class="nav-button " data-action="go-MP01" bindtap="onAction" aria-label="整理"><image class="nav-icon" src="/assets/icons/folder.png" aria-hidden="true"/><text>整理</text></button><button class="nav-button nav-current" data-action="go-MP13" bindtap="onAction" aria-label="任务，当前页面"><image class="nav-icon" src="/assets/icons/clipboard-filled.png" aria-hidden="true"/><text>任务</text></button><button class="nav-button " data-action="go-MP14" bindtap="onAction" aria-label="规范"><image class="nav-icon" src="/assets/icons/grid.png" aria-hidden="true"/><text>规范</text></button><button class="nav-button " data-action="go-MP15" bindtap="onAction" aria-label="我的"><image class="nav-icon" src="/assets/icons/user.png" aria-hidden="true"/><text>我的</text></button></b-navigation>
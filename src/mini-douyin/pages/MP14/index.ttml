<b-frame variant="page-root"><view tt:if="{{loading}}" class="notice">正在处理，请稍候……</view><view tt:if="{{error}}" class="error">{{error}}<button class="button" data-action="refresh" bindtap="onAction">重新读取状态</button></view><b-message text="{{notice}}"/><b-heading title="我的规范"/>
<b-filter title="查找私有规范"><input aria-label="按规范名称搜索" value="{{name}}" data-field="name" bindinput="onInput" maxlength="200" placeholder="按规范名称搜索"/><button class="button" data-action="refresh" bindtap="onAction">查找规范</button></b-filter>
<b-feedback tt:if="{{!templates.length}}" title="还没有保存的规范" text="整理完成后，可将确认过的字段和规则另存于此。"/>
<b-template tt:for="{{templates}}" tt:key="template_id" title="{{item.name}}" text="版本 {{item.version}} · {{item.schema.fields.length}} 个字段"><button class="button" data-action="use-template" data-id="{{item.template_id}}" bindtap="onAction">用此规范整理</button><button class="button" data-action="edit-template" data-id="{{item.template_id}}" bindtap="onAction">编辑并另存新版本</button><button class="button danger" data-action="delete-template" data-id="{{item.template_id}}" bindtap="onAction">停止以后复用此规范</button></b-template>
<button tt:if="{{nextCursor}}" class="button" data-action="load-more" bindtap="onAction" disabled="{{loading}}">加载下一页规范</button>
</b-frame><b-navigation><button class="nav-button " data-action="go-MP01" bindtap="onAction" aria-label="整理"><image class="nav-icon" src="/assets/icons/folder.png" aria-hidden="true"/><text>整理</text></button><button class="nav-button " data-action="go-MP13" bindtap="onAction" aria-label="任务"><image class="nav-icon" src="/assets/icons/clipboard.png" aria-hidden="true"/><text>任务</text></button><button class="nav-button nav-current" data-action="go-MP14" bindtap="onAction" aria-label="规范，当前页面"><image class="nav-icon" src="/assets/icons/grid-filled.png" aria-hidden="true"/><text>规范</text></button><button class="nav-button " data-action="go-MP15" bindtap="onAction" aria-label="我的"><image class="nav-icon" src="/assets/icons/user.png" aria-hidden="true"/><text>我的</text></button></b-navigation>
<view class="field-card"><button a:if="{{action}}" class="field-main field-trigger" onTap="act" aria-label="{{'调整字段：'+title}}"><view class="icon-tile field-icon-tile"><image class="icon" src="{{'/assets/icons/'+(icon||'text')+'.png'}}" aria-hidden="true"/></view><view class="grow"><view class="card-title">{{title}}</view><view class="small">{{text}}</view></view><view a:if="{{meta}}" class="field-reason">{{meta}}</view><image class="chevron" src="/assets/icons/chevron.png" aria-hidden="true"/></button><view a:if="{{!action}}" class="field-main"><view class="icon-tile field-icon-tile"><image class="icon" src="{{'/assets/icons/'+(icon||'text')+'.png'}}" aria-hidden="true"/></view><view class="grow"><view class="card-title">{{title}}</view><view class="small">{{text}}</view></view><view a:if="{{meta}}" class="field-reason">{{meta}}</view></view><slot/></view>
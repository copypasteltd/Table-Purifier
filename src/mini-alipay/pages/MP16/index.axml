<b-frame variant=""><view a:if="{{loading}}" class="notice">正在处理，请稍候……</view><view a:if="{{error}}" class="error">{{error}}<button class="button" data-action="refresh" onTap="onAction">重新读取状态</button></view><b-message text="{{notice}}"/><b-order title="原平台订单" text="{{order.order_id}}"><view class="quote">{{order.amount.amount_minor}} <text class="muted">{{order.amount.amount_unit==='CNY_FEN'?'人民币分':'抖音钻石'}}</text></view><view>付款：{{paymentLabel}}</view><view>履约：{{fulfillmentLabel}}</view><view>退款：{{refundLabel}}</view><view class="small">已核实退回：{{order.refunded_minor}}（原单位）</view></b-order>
<b-status title="付款与履约分别记录" text="收银弹窗返回成功不代表服务端实付确认。状态未知时先查询此原订单。"/>
<button class="button primary" data-action="refresh" onTap="onAction" disabled="{{loading}}">查询原订单状态</button>
<button a:if="{{order.payment_status==='NOT_CREATED'||order.payment_status==='PENDING'}}" class="button" data-action="continue-checkout" onTap="onAction" disabled="{{loading}}">继续原订单收银</button>
<button a:if="{{order.payment_status==='CONFIRMED'&&order.fulfillment_status==='NOT_STARTED'}}" class="button" data-action="start-run" onTap="onAction" disabled="{{loading}}">付款已核实，继续生产</button>
<button class="button" data-action="go-MP04" onTap="onAction">返回原方案与交付范围</button>
<text class="label">退款原因（选填）</text><input aria-label="退款原因，选填" value="{{note}}" maxlength="200" data-field="note" onInput="onInput"/><button class="button danger" data-action="refund" onTap="onAction" disabled="{{loading}}">申请原平台退款</button><button class="button" data-action="go-MP18" onTap="onAction">联系售后</button>
</b-frame>
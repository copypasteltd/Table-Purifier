/* Frozen B1.0.0 palette and logical-pixel scale. Native hosts use the same source. */
page { background:#EAF1EE; color:#203C32; font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif; font-size:16px; line-height:24px; }
view,text,input,textarea,button,image { box-sizing:border-box; }
.page { max-width:640px; min-height:100vh; margin:0 auto; padding:16px 16px 104px; background:#fff; overflow-wrap:anywhere; }
.page-root { padding-bottom:164px; }
.hero { font-size:24px; font-weight:600; line-height:34px; margin:0 0 4px; }
.home-subtitle { margin-bottom:20px; }
.muted { color:#5E7167; font-size:14px; line-height:22px; }
.small { font-size:12px; line-height:18px; color:#5E7167; }
.section { padding:16px; border:1px solid #D4E2DA; border-radius:12px; background:#fff; margin:12px 0 16px; }
.section-title { display:flex; align-items:center; font-size:18px; line-height:26px; font-weight:600; margin:24px 0 12px; }
.section-title::before { content:""; display:block; width:3px; height:18px; border-radius:2px; background:#4A8B70; margin-right:10px; flex-shrink:0; }
.section .section-title { margin-top:0; }
.heading-count { font-size:14px; line-height:22px; font-weight:400; margin-left:8px; color:#5E7167; }
.row { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8px; }
.stack { display:flex; flex-direction:column; gap:12px; }
.grow { flex:1; min-width:0; }
.folder { position:relative; background:#fff; border:1px solid #A8C8B8; border-top:4px solid #4A8B70; border-radius:0 12px 12px 12px; padding:12px; margin:28px 0 24px; }
.folder-tab { position:absolute; left:-1px; top:-17px; width:76px; height:13px; background:#BED8C9; border-radius:8px 8px 0 0; }
.folder-heading { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:4px 8px; margin:0 0 8px; }
.folder-title { font-size:18px; line-height:26px; font-weight:600; }
.folder-footer { display:flex; justify-content:space-between; align-items:center; gap:8px; padding:0 0 0 4px; }
.source-row { border:1px solid #D4E2DA; border-radius:10px; padding:8px 12px; margin:8px 0; background:#fff; min-height:64px; }
.source-main,.field-main,.file-heading,.evidence-heading { display:flex; align-items:center; gap:12px; min-width:0; }
.icon-tile { display:flex; align-items:center; justify-content:center; flex:0 0 36px; height:40px; border-radius:8px; background:#F6F9F7; }
.icon { display:block; width:24px; height:24px; flex-shrink:0; }
.file-icon { display:block; width:32px; height:36px; flex-shrink:0; }
.card-title { font-size:16px; line-height:24px; font-weight:500; }
.icon-action { display:flex; align-items:center; justify-content:center; flex:0 0 48px; width:48px; min-height:48px; margin:-4px -8px -4px 0; padding:0; background:transparent; border:0; border-radius:8px; color:#5E7167; }
.icon-action::after,.mode::after,.nav-button::after,.text-button::after { border:0; }
.text-button { display:flex; align-items:center; justify-content:center; gap:6px; padding:8px; margin:0; min-height:48px; border:0; background:transparent; border-radius:8px; color:#17745E; font-size:14px; line-height:22px; }
.text-button.muted { color:#5E7167; }
.add-source { display:flex; align-items:center; justify-content:center; gap:8px; min-height:64px; width:100%; background:#F6F9F7; border:1px dashed #A8C8B8; border-radius:10px; padding:12px; color:#17745E; font-size:16px; margin:8px 0; }
.label { display:block; font-size:16px; line-height:24px; font-weight:500; margin:12px 0 8px; }
.input-group { margin:12px 0; }
.input-hint { display:block; color:#5E7167; font-size:12px; line-height:18px; margin-top:8px; }
input,textarea { display:block; width:100%; background:#F6F9F7; border:1px solid #D4E2DA; border-radius:8px; padding:12px; color:#203C32; font-size:16px; line-height:24px; min-height:48px; }
input[disabled] { color:#5E7167; background:#F0F4F1; }
textarea { height:160px; }
.textarea-small { height:100px; }
.button { display:block; width:100%; min-height:52px; padding:12px 16px; margin:8px 0; border:1px solid #17745E; border-radius:8px; background:#fff; color:#17745E; font-size:16px; line-height:26px; font-weight:500; white-space:normal; }
.button::after { border:none; }
.primary { background:#17745E; color:#fff; }
.danger { border-color:#B33E32; color:#B33E32; }
.button[disabled],.choice[disabled] { background:#E3EBE6; color:#5E7167; border-color:#D4E2DA; }
.button:active,.icon-action:active,.text-button:active,.nav-button:active { background:#E8F3ED; }
.primary:active { background:#105F4D; }
.split { display:flex; gap:12px; flex-wrap:wrap; }
.split > view { flex:1; min-width:142px; }
.mode { display:block; width:100%; text-align:left; background:#fff; color:#203C32; border:1px solid #6F897C; border-radius:8px; padding:12px; min-height:88px; margin:0; font-size:16px; line-height:24px; }
.mode-selected { border-color:#17745E; background:#E8F3ED; }
.mode-title { display:flex; align-items:center; gap:8px; font-weight:500; }
.mode-hint { margin:5px 0 0 26px; }
.radio { display:flex; align-items:center; justify-content:center; width:18px; height:18px; border:1px solid #6F897C; border-radius:50%; flex:0 0 18px; }
.radio-selected { border-color:#17745E; }
.radio-selected::after { content:""; display:block; width:10px; height:10px; border-radius:50%; background:#17745E; }
.badge { display:inline-block; flex-shrink:0; white-space:nowrap; border:1px solid #A8C8B8; background:#E8F3ED; color:#17745E; border-radius:4px; padding:2px 6px; font-size:12px; line-height:18px; font-weight:400; }
.warning,.issue-strip { background:#FFF3DB; color:#875A18; border:1px solid #E7CFA2; border-radius:8px; padding:12px; margin:12px 0; font-size:14px; line-height:22px; }
.issue-strip { display:flex; align-items:center; gap:8px; }
.issue-strip .badge { background:#FFF3DB; color:#875A18; border-color:#E7CFA2; }
.error { background:#FDF0ED; color:#B33E32; border:1px solid #B33E32; border-radius:8px; padding:12px; margin:12px 0; }
.notice { padding:12px; border:1px solid #D4E2DA; border-radius:8px; background:#F6F9F7; margin:12px 0; font-size:14px; line-height:22px; }
.record { padding:16px; border:1px solid #D4E2DA; border-radius:12px; margin:12px 0; background:#fff; }
.record-heading { margin-bottom:8px; }
.field-row { display:flex; flex-wrap:wrap; gap:8px; padding:7px 0; }
.field-label { min-width:80px; color:#5E7167; font-size:14px; line-height:22px; }
.field-value { flex:1; min-width:100px; white-space:pre-wrap; }
.quote { font-size:24px; font-weight:600; line-height:34px; margin:12px 0; }
.schema-title { font-size:24px; line-height:34px; font-weight:600; margin-bottom:8px; }
.schema-summary .badge { margin-top:12px; }
.section-heading-row { display:flex; justify-content:space-between; align-items:center; gap:8px; margin-top:20px; }
.section-heading-row .section-title { margin:0; flex-shrink:0; }
.section-heading-row .text-button { text-align:right; padding-right:0; }
.field-card { padding:12px; min-height:76px; border:1px solid #D4E2DA; border-radius:10px; margin:8px 0; }
.field-icon-tile { width:40px; height:40px; flex-basis:40px; background:#E8F3ED; }
.field-reason { max-width:104px; font-size:12px; line-height:18px; color:#5E7167; }
.chevron { display:block; width:16px; height:16px; flex:0 0 16px; }
.table-card { border:1px solid #D4E2DA; border-radius:10px; overflow:hidden; margin:12px 0 24px; }
.horizontal { display:block; white-space:nowrap; width:100%; }
.table-grid { min-width:340px; }
.table-row { display:flex; align-items:stretch; border-bottom:1px solid #D4E2DA; }
.table-row:last-child { border-bottom:0; }
.table-head { background:#F0F4F1; font-weight:500; }
.table-cell { flex:1; min-width:85px; padding:12px 10px; white-space:normal; font-size:14px; line-height:22px; border-right:1px solid #D4E2DA; overflow-wrap:anywhere; }
.table-cell:last-child { border-right:0; }
.cell-unresolved { background:#FFF3DB; color:#875A18; }
.table-caption { padding:10px 12px; color:#5E7167; font-size:12px; line-height:18px; border-top:1px solid #D4E2DA; white-space:normal; background:#F6F9F7; }
.evidence-card { border:1px solid #D4E2DA; padding:12px; border-radius:10px; margin:12px 0; }
.evidence-heading { margin-bottom:8px; }
.excerpt { white-space:pre-wrap; font-size:16px; line-height:26px; color:#203C32; }
.evidence-card .text-button { justify-content:flex-start; padding-left:0; }
.issue-facts { padding:8px 12px; border:1px solid #D4E2DA; border-radius:10px; margin-top:12px; }
.issue-facts .field-row { align-items:center; }
.issue-facts .field-value { text-align:right; }
.issue-facts .cell-unresolved { padding:3px 8px; border-radius:4px; }
.decision-section { margin:24px 0; }
.action-bar { margin:20px 0; }
.action-inner { display:flex; gap:12px; flex-wrap:wrap; }
.action-inner > .button { flex:1; min-width:120px; margin:0; }
.action-bar.fixed,.action-bar.fixed-home { position:fixed; left:0; right:0; bottom:0; margin:0; padding:12px 16px; padding-bottom:calc(12px + env(safe-area-inset-bottom)); background:#fff; border-top:1px solid #D4E2DA; z-index:9; }
.action-bar.fixed-home { bottom:calc(56px + env(safe-area-inset-bottom)); padding-bottom:12px; border-top:0; }
.action-bar.fixed .action-inner,.action-bar.fixed-home .action-inner { max-width:608px; margin:0 auto; }
.bottom { position:fixed; left:0; right:0; bottom:0; background:#fff; border-top:1px solid #D4E2DA; padding:0 16px; padding-bottom:env(safe-area-inset-bottom); display:flex; gap:8px; justify-content:center; z-index:10; }
.nav-button { flex:1; max-width:146px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:2px; padding:4px; margin:0; min-height:56px; min-width:48px; text-align:center; font-size:12px; line-height:18px; color:#5E7167; background:#fff; border:0; border-radius:0; }
.nav-icon { display:block; width:24px; height:24px; }
.nav-current { color:#17745E; font-weight:500; }
.choice { display:block; width:100%; text-align:left; padding:10px 12px; min-height:64px; margin:10px 0; border:1px solid #6F897C; color:#203C32; background:#fff; border-radius:8px; font-size:16px; line-height:24px; }
.choice-title { display:flex; align-items:center; gap:10px; }
.choice .small { display:block; margin:5px 0 0 28px; }
.selected { border-color:#17745E; background:#E8F3ED; }
.spaced { margin:16px 0; }
.choices { display:flex; flex-wrap:wrap; gap:8px; margin:8px 0; }
.choices .choice { flex:0 1 auto; width:auto; min-height:48px; min-width:72px; padding:10px 12px; margin:0; }
.source-row input { margin-bottom:8px; }
button:focus-visible,input:focus-visible,textarea:focus-visible { outline:2px solid #17745E; outline-offset:3px; }
@media (max-width:359px) { .split > view { min-width:100%; } .field-reason { max-width:80px; } .field-main { gap:8px; } }
@media (prefers-reduced-motion:reduce) { page { scroll-behavior:auto; } }

.folder.compact { margin-top:12px; }
.issue-folder .folder-title { font-size:24px; line-height:34px; }

.field-trigger { width:100%; padding:0; margin:0; min-height:48px; border:0; background:transparent; color:#203C32; text-align:left; font-size:16px; line-height:24px; }
.field-trigger::after { border:0; }
.field-trigger:active { background:#F6F9F7; }

.folder-footer .text-button { margin:-8px 0; }
.home-footer { position:fixed; left:0; right:0; bottom:0; z-index:10; background:#fff; }
.action-bar.embedded { margin:0; padding:12px 16px; }
.action-bar.embedded .action-inner { max-width:608px; margin:0 auto; }
.bottom.embedded { position:static; }
.status-dot { display:flex; align-items:center; justify-content:center; width:22px; height:22px; border-radius:50%; background:#875A18; color:#fff; font-weight:600; }
.evidence-card { display:flex; align-items:center; flex-wrap:wrap; gap:8px; }
.evidence-heading { flex:1; min-width:160px; margin:0; align-items:flex-start; }
.evidence-card .excerpt { display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
.evidence-caption { margin-top:6px; }
.evidence-card .text-button { flex-shrink:0; }

.issue-facts .field-row { padding:5px 0; }

.folder.home-folder { margin-top:20px; }

.split > .button,.split > .choice { flex:1; width:auto; min-width:120px; }

<b-frame><view a:if="{{loading}}" class="notice">正在处理，请稍候……</view><view a:if="{{error}}" class="error">{{error}}<button class="button" data-action="refresh" onTap="onAction">重新读取状态</button></view><b-message text="{{notice}}"/><b-heading title="我的整理任务"/>
<b-feedback a:if="{{!tasks.length}}" title="还没有整理任务" text="新建会话，提交零散资料，从推荐规范开始。"/>
<b-task a:for="{{tasks}}" a:key="task_id" title="{{item.goal||'资料成表任务'}}" text="{{item.current_result_version?'已有结果，可查看和再次领取':'点击读取最新任务状态'}}"><button class="button" data-action="view-task" data-id="{{item.task_id}}" onTap="onAction">继续此任务</button></b-task>
<button a:if="{{nextCursor}}" class="button" data-action="load-more" onTap="onAction" disabled="{{loading}}">加载下一页任务</button>
<button class="button primary" data-action="go-MP01" onTap="onAction">新建整理</button>
</b-frame><b-navigation><view class="nav-button " data-action="go-MP01" onTap="onAction">整理</view><view class="nav-button nav-current" data-action="go-MP13" onTap="onAction">任务</view><view class="nav-button " data-action="go-MP14" onTap="onAction">规范</view><view class="nav-button " data-action="go-MP15" onTap="onAction">我的</view></b-navigation>
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:p07:engine:1",
  "$defs": {
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "const": "P07-ENGINE-1"
        },
        "attempt_id": {
          "type": "string",
          "format": "uuid"
        },
        "action": {
          "type": "string",
          "enum": [
            "PARSE",
            "NORMALIZE",
            "VALIDATE",
            "BUILD"
          ]
        },
        "input_manifest_path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\]).+$",
          "maxLength": 1000,
          "description": "Project-relative forward slash path. Host verifies resolved path/ACL and reparse-point containment; regex alone is insufficient."
        },
        "output_dir": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\]).+$",
          "maxLength": 1000,
          "description": "Project-relative forward slash path. Host verifies resolved path/ACL and reparse-point containment; regex alone is insufficient."
        },
        "deadline_at": {
          "type": "string",
          "format": "date-time"
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "versions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "parser": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "unitizer": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "rule_engine": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "exporter": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "parser",
            "unitizer",
            "rule_engine",
            "exporter"
          ]
        },
        "binding_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_set_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "protocol_version",
        "attempt_id",
        "action",
        "input_manifest_path",
        "output_dir",
        "deadline_at",
        "max_output_bytes",
        "versions",
        "binding_sha256",
        "source_set_sha256"
      ]
    },
    "Event": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "const": "P07-ENGINE-1"
        },
        "attempt_id": {
          "type": "string",
          "format": "uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "type": {
          "type": "string",
          "enum": [
            "PROGRESS",
            "RESULT",
            "ERROR"
          ]
        },
        "stage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "processed_units": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "checkpoint_manifest_path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\]).+$",
          "maxLength": 1000,
          "description": "Project-relative forward slash path. Host verifies resolved path/ACL and reparse-point containment; regex alone is insufficient."
        },
        "output_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "error_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "retry_class": {
          "type": "string",
          "enum": [
            "RETRYABLE",
            "PERMANENT",
            "UNKNOWN_EXTERNAL",
            "USER_ACTION",
            "BUDGET_EXCEEDED"
          ]
        }
      },
      "required": [
        "protocol_version",
        "attempt_id",
        "sequence",
        "type",
        "stage"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "RESULT"
              }
            }
          },
          "then": {
            "required": [
              "checkpoint_manifest_path",
              "output_sha256"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "ERROR"
              }
            }
          },
          "then": {
            "required": [
              "error_code",
              "retry_class"
            ]
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/Request"
    },
    {
      "$ref": "#/$defs/Event"
    }
  ],
  "description": "One bounded stdin JSON request; stdout JSONL events. Progress is observation, final RESULT+exit0+readback required. No DB/payment secret."
}

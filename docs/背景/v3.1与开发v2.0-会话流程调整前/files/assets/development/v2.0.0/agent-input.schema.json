{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:p07:agent-input:2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "const": "P07-AGENT-2"
    },
    "task_id": {
      "type": "string",
      "format": "uuid"
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "operation_id": {
      "type": "string",
      "format": "uuid"
    },
    "attempt_id": {
      "type": "string",
      "format": "uuid"
    },
    "fence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "task_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "phase": {
      "enum": [
        "PREFLIGHT",
        "EXECUTE",
        "CONTINUE_AFTER_ADOPTION",
        "REVISE"
      ]
    },
    "mode": {
      "enum": [
        "PROVIDED",
        "DISCOVER"
      ]
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "goal_version": {
      "type": "integer",
      "minimum": 1
    },
    "source_set_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "contract_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "enum": [
              "SOURCE",
              "TEMPLATE"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\]).+$",
            "maxLength": 1000,
            "description": "Workspace-relative path. Realpath, ACL, ADS and reparse-point checks remain mandatory."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "read_scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "source_id",
          "role",
          "path",
          "sha256",
          "bytes",
          "read_scope"
        ]
      },
      "minItems": 0,
      "maxItems": 11
    },
    "scope_manifest_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\]).+$",
      "maxLength": 1000,
      "description": "Workspace-relative path. Realpath, ACL, ADS and reparse-point checks remain mandatory."
    },
    "binding": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_id": {
              "type": "string",
              "format": "uuid"
            },
            "version": {
              "type": "integer",
              "minimum": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "path": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\]).+$",
              "maxLength": 1000,
              "description": "Workspace-relative path. Realpath, ACL, ADS and reparse-point checks remain mandatory."
            }
          },
          "required": [
            "schema_id",
            "version",
            "sha256",
            "path"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "adoption_receipt_path": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\]).+$",
          "maxLength": 1000,
          "description": "Workspace-relative path. Realpath, ACL, ADS and reparse-point checks remain mandatory."
        },
        {
          "type": "null"
        }
      ]
    },
    "parent_result_path": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\]).+$",
          "maxLength": 1000,
          "description": "Workspace-relative path. Realpath, ACL, ADS and reparse-point checks remain mandatory."
        },
        {
          "type": "null"
        }
      ]
    },
    "decision_batch_path": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\]).+$",
          "maxLength": 1000,
          "description": "Workspace-relative path. Realpath, ACL, ADS and reparse-point checks remain mandatory."
        },
        {
          "type": "null"
        }
      ]
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "remaining_compute_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 900000
        },
        "semantic_units_max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        },
        "fields_max": {
          "const": 50
        },
        "records_max": {
          "const": 1000
        },
        "output_bytes_max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "remaining_compute_ms",
        "semantic_units_max",
        "fields_max",
        "records_max",
        "output_bytes_max"
      ]
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sdk": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "cli": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "instructions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "toolkit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "unitizer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "validator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "sdk",
        "cli",
        "model",
        "instructions",
        "toolkit",
        "unitizer",
        "validator"
      ]
    },
    "expected_output_schema": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\]).+$",
      "maxLength": 1000,
      "description": "Workspace-relative path. Realpath, ACL, ADS and reparse-point checks remain mandatory."
    }
  },
  "required": [
    "protocol_version",
    "task_id",
    "run_id",
    "operation_id",
    "attempt_id",
    "fence",
    "task_epoch",
    "phase",
    "mode",
    "goal",
    "goal_version",
    "source_set_sha256",
    "contract_sha256",
    "workspace_id",
    "inputs",
    "scope_manifest_path",
    "binding",
    "adoption_receipt_path",
    "parent_result_path",
    "decision_batch_path",
    "budget",
    "versions",
    "expected_output_schema"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {
            "const": "PREFLIGHT"
          }
        }
      },
      "then": {
        "properties": {
          "run_id": {
            "type": "null"
          },
          "budget": {
            "properties": {
              "semantic_units_max": {
                "maximum": 3
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "enum": [
              "EXECUTE",
              "CONTINUE_AFTER_ADOPTION",
              "REVISE"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "run_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "PROVIDED"
          },
          "phase": {
            "const": "EXECUTE"
          }
        }
      },
      "then": {
        "properties": {
          "binding": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "schema_id": {
                "type": "string",
                "format": "uuid"
              },
              "version": {
                "type": "integer",
                "minimum": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "path": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\]).+$",
                "maxLength": 1000,
                "description": "Workspace-relative path. Realpath, ACL, ADS and reparse-point checks remain mandatory."
              }
            },
            "required": [
              "schema_id",
              "version",
              "sha256",
              "path"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "enum": [
              "CONTINUE_AFTER_ADOPTION",
              "REVISE"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "binding": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "schema_id": {
                "type": "string",
                "format": "uuid"
              },
              "version": {
                "type": "integer",
                "minimum": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "path": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\]).+$",
                "maxLength": 1000,
                "description": "Workspace-relative path. Realpath, ACL, ADS and reparse-point checks remain mandatory."
              }
            },
            "required": [
              "schema_id",
              "version",
              "sha256",
              "path"
            ]
          },
          "adoption_receipt_path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\]).+$",
            "maxLength": 1000,
            "description": "Workspace-relative path. Realpath, ACL, ADS and reparse-point checks remain mandatory."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "REVISE"
          }
        }
      },
      "then": {
        "properties": {
          "parent_result_path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\]).+$",
            "maxLength": 1000,
            "description": "Workspace-relative path. Realpath, ACL, ADS and reparse-point checks remain mandatory."
          },
          "decision_batch_path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\]).+$",
            "maxLength": 1000,
            "description": "Workspace-relative path. Realpath, ACL, ADS and reparse-point checks remain mandatory."
          }
        }
      }
    }
  ]
}

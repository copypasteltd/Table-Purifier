<view class="home-brand"><image class="brand-logo" src="{{brand.logo}}" mode="aspectFit" aria-hidden="true"/><view class="hero">{{brand.name}}</view></view>
<view class="muted home-subtitle">把零散资料整理成表，没有模板也能开始</view>
<b-progress p:if="{{!ready}}" title="整理会话" text="{{phase}}"/>
<button p:if="{{!session||session.status==='CLOSED'||session.status==='FAILED'||session.status==='INITIALIZATION_FAILED'||session.status==='CANCELED'}}" class="button primary" data-action="new" onTap="onAction" disabled="{{loading}}">新建整理会话</button>
<view p:if="{{ready}}">
 <b-folder variant="home-folder" title="添加资料" text="文字 / 图片 / 文件">
  <b-source p:for="{{homeSources}}" p:key="source_id" title="{{item.name}}" text="{{item.meta}}" icon="{{item.icon}}" action="go-MP02" onAction="onAction"/>
  <button p:if="{{!sourceCount}}" class="add-source" data-action="go-MP02" onTap="onAction"><image class="icon" src="/assets/icons/plus.png" aria-hidden="true"/>添加第一份资料</button>
  <view class="folder-footer"><text class="small">{{sourceCount}} 份资料</text><button class="text-button" data-action="go-MP02" onTap="onAction">{{sourceCount?'管理资料':'粘贴文字'}}<image class="chevron" src="/assets/icons/chevron.png" aria-hidden="true"/></button><button p:if="{{sourceCount}}" class="text-button muted" data-action="clear-sources" onTap="onAction" disabled="{{loading}}"><image class="icon" src="/assets/icons/trash.png" aria-hidden="true"/>清空</button></view>
 </b-folder>
 <b-heading title="规范从哪里来"/>
 <view class="split"><view><b-mode title="帮我生成规范" text="先分析，再由你确认" selected="{{mode==='DISCOVER'}}" action="mode-discover" onAction="onAction"/></view><view><b-mode title="我有规范" text="照我的表格整理" selected="{{mode==='PROVIDED'}}" action="mode-provided" onAction="onAction"/></view></view>
 <b-heading title="这次想整理什么"/>
 <input value="{{goal}}" disabled="{{!!task}}" maxlength="1000" data-field="goal" onInput="onInput" aria-label="这次想整理什么，选填" placeholder="例如：汇总供应商报价，一件商品一行"/>
 <button p:if="{{mode==='PROVIDED'}}" class="button" data-action="go-MP03" onTap="onAction">提供规范</button>
 <view class="row"><text class="small">{{sourceCount?'资料已接收，待你发起检查':'会话已就绪，只处理你提交的资料'}}</text><button class="text-button" data-action="go-MP17" onTap="onAction">资料用途说明</button></view>
</view>
<button p:if="{{!ready}}" class="text-button" data-action="go-MP17" onTap="onAction">资料用途与保存说明</button>

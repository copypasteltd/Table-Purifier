<b-heading title="隐私与数据管理"/>
<b-privacy title="为什么处理资料" text="{{policy.policy_version}}"><view p:for="{{policy.purposes}}" p:key="*this">{{item}}</view></b-privacy>
<b-heading title="实际数据处理方"/><view p:if="{{!policy.processors.length}}" class="notice">当前尚未配置外部模型处理方，真实资料处理能力保持关闭。</view><view class="section" p:for="{{policy.processors}}" p:key="name"><view>{{item.name}} · {{item.region}}</view><view>{{item.purpose}}</view><view class="small">保存：{{item.retention}}</view><view class="small">删除限制：{{item.deletion_limitations}}</view></view>
<b-heading title="资料保存与清理"/><view p:for="{{policy.retention_categories}}" p:key="category" class="section"><view>{{item.category==='TASK_RUNTIME'?'本次任务环境':item.category==='RESULT'?'最终结果':item.category}}</view><view class="small">{{item.limitations}}</view></view>
<button class="button primary" data-action="consent" onTap="onAction" disabled="{{loading||!policy}}">同意为本次整理处理资料</button><button class="button" data-action="withdraw" onTap="onAction" disabled="{{loading}}">撤回新的资料处理授权</button>
<b-privacy title="主动删除" text="主动删除可以清除结果；日常任务结束只销毁任务环境，保留最终文件。已领取到个人设备的副本无法撤回。"/>
<button class="button danger" data-action="delete-task" onTap="onAction" disabled="{{loading||!task}}">删除当前任务的资料与结果</button><button class="button danger" data-action="delete-account" onTap="onAction" disabled="{{loading}}">注销账号并删除账号资料</button>
<b-status p:if="{{deletion}}" title="资料删除进度" text="{{deletion.status==='COMPLETED'?'所选资料已清理':deletion.status==='PARTIAL_FAILED'?'部分清理尚未完成，可重试':'访问已撤销，正在清理'}}"><view class="small">{{deletion.deletion_request_id}}</view><button class="button" data-action="deletion-status" onTap="onAction">查询删除进度</button><button p:if="{{deletion.status==='PARTIAL_FAILED'}}" class="button" data-action="retry-deletion" onTap="onAction" disabled="{{loading}}">重试未完成的清理</button></b-status>

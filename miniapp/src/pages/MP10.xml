<view class="muted">当前记录的字段确认</view>
<view class="issue-strip" aria-label="{{issue.message}}"><text class="status-dot" aria-hidden="true">!</text><text>{{issueLabel}}待确认</text></view>
<b-folder variant="issue-folder" title="{{issueRecordTitle}}"><view class="muted">{{issueRecordSubtitle}}</view><view class="issue-facts"><view p:for="{{issueFacts}}" p:key="id" class="field-row"><text class="field-label">{{item.label}}</text><text class="field-value"><text class="{{item.unresolved?'cell-unresolved':''}}">{{item.value}}</text></text></view></view><view p:if="{{!issueRecordAvailable}}" class="small">完整记录暂不可用，当前仅展示问题字段，请查看来源依据。</view></b-folder>
<b-heading title="来源依据"/>
<b-evidence p:for="{{excerpts}}" p:key="evidence_id" title="{{item.locator.path||'结果保留摘录'}}" text="{{item.excerpt}}"><button class="text-button" data-action="evidence" data-id="{{item.evidence_id}}" onTap="onAction">查看来源<image class="chevron" src="/assets/icons/chevron.png" aria-hidden="true"/></button><button p:if="{{canEvidence&&reworkReady}}" class="button" data-action="CHOOSE_EVIDENCE" data-id="{{item.evidence_id}}" onTap="onChoice">{{selectedEvidence===item.evidence_id?'已选择此依据':'采用此依据'}}</button></b-evidence>
<b-progress p:if="{{!reworkReady}}" title="先准备新的调整会话" text="{{reworkPhase}}"/>
<view p:if="{{reworkReady}}">
<b-decision title="如何处理该字段">
 <button p:if="{{canUserValue}}" aria-pressed="{{selectedAction==='USER_VALUE'}}" class="choice {{selectedAction==='USER_VALUE'?'selected':''}}" data-action="USER_VALUE" onTap="onChoice"><view class="choice-title"><view class="radio {{selectedAction==='USER_VALUE'?'radio-selected':''}}" aria-hidden="true"/><text>补充{{issueLabel}}</text></view><text class="small">输入准确值，记为你主动补充</text></button>
 <b-input p:if="{{selectedAction==='USER_VALUE'}}" title="{{issueLabel}}" text="按规范填写；金额使用精确小数字符串。"><input value="{{value}}" data-field="value" onInput="onInput" maxlength="50000" aria-label="{{issueLabel}}" placeholder="请输入有依据的准确值"/></b-input>
 <button p:if="{{canKeep}}" aria-pressed="{{selectedAction==='KEEP_UNRESOLVED'}}" class="choice {{selectedAction==='KEEP_UNRESOLVED'?'selected':''}}" data-action="KEEP_UNRESOLVED" onTap="onChoice"><view class="choice-title"><view class="radio {{selectedAction==='KEEP_UNRESOLVED'?'radio-selected':''}}" aria-hidden="true"/><text>保留待补</text></view><text class="small">不填猜测值，继续保留待确认状态</text></button>
</b-decision>
<b-confirmation p:if="{{decisionPreview}}" title="本次影响 {{decisionPreview.affected_records}} 条记录" text="决定将提交到新会话，再分析并确认方案与费用。原结果继续保留。"/>
<b-actions variant="fixed"><button p:if="{{!decisionPreview}}" class="button primary" data-action="decision-preview" onTap="onAction" disabled="{{loading||!selectedAction}}">预览修改影响</button><button p:if="{{decisionPreview}}" class="button primary" data-action="decision-submit" onTap="onAction" disabled="{{loading}}">确认决定，继续整理</button></b-actions>
</view>

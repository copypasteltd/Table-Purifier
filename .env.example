# Copy to .env inside this project. Never commit a real .env or paste secrets into chat.
P07_ENV=development
P07_HOST=127.0.0.1
P07_PORT=4317
P07_PUBLIC_URL=http://127.0.0.1:4317
# Explicit opt-in for an operator-requested production HTTP listener. No TLS/HSTS upgrade is emitted for HTTP URLs.
P07_ALLOW_HTTP_DEPLOYMENT=false
# API/worker must use a non-superuser, non-owner role. Migration uses a separate URL.
P07_DATABASE_URL=
P07_WORKER_DATABASE_URL=
P07_MIGRATION_DATABASE_URL=
P07_STORAGE_ROOT=runtime
P07_TOKEN_SECRET=
P07_IDENTITY_SECRET=
P07_AGENT_ENABLED=false
P07_CODEX_MODEL=
P07_CODEX_API_KEY=
P07_CODEX_BASE_URL=
P07_CODEX_PATH=
P07_TESSERACT_PATH=
P07_AGENT_BOOTSTRAP_MS=120000
P07_AGENT_ANALYSIS_MS=300000
P07_AGENT_BATCH_MS=900000
P07_AGENT_ADJUSTMENT_ROUNDS=5
P07_AGENT_IDLE_SECONDS=3600
P07_AGENT_CONTEXT_TOKENS=64000
P07_WORKER_CONCURRENCY=1
P07_ISOLATION_PROFILE=
# Platform release flags default false. Real app/SKU/OS evidence is required.
P07_ALIPAY_ENABLED=false
P07_ALIPAY_APP_ID=
P07_ALIPAY_APP_ALIAS=alipay-main
P07_ALIPAY_PRIVATE_KEY_FILE=
P07_ALIPAY_PUBLIC_KEY_FILE=
P07_ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
P07_DOUYIN_ENABLED=false
P07_DOUYIN_APP_ID=
P07_DOUYIN_APP_ALIAS=douyin-main
P07_DOUYIN_APP_SECRET=
P07_DOUYIN_PRIVATE_KEY_FILE=
P07_DOUYIN_PUBLIC_KEY_FILE=
P07_DOUYIN_PRODUCT_FILE=config/douyin-product.json
P07_DOUYIN_MERCHANT_ID=
P07_COMMERCE_ENABLED=false
P07_PRICE_POLICY=flat-v1
P07_PRICE_BASE_MINOR=100
P07_PRICE_UNIT_MINOR=10
P07_PRICE_MAX_MINOR=3000
P07_POLICY_VERSION=privacy-2026-10-27
P07_OPERATOR_TOKEN_HASH=
P07_PROCESSOR_POLICY_FILE=

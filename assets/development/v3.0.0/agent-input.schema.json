{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:p07:agent-input:3",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "const": "P07-AGENT-3"
    },
    "session_id": {
      "type": "string",
      "format": "uuid"
    },
    "task_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "attempt_id": {
      "type": "string",
      "format": "uuid"
    },
    "fence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "phase": {
      "enum": [
        "BOOTSTRAP",
        "ANALYZE",
        "ADJUST",
        "BATCH",
        "REPAIR"
      ]
    },
    "skill_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "skill_preload_receipt_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "input_manifest_path": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\]).+$",
          "maxLength": 1000
        },
        {
          "type": "null"
        }
      ]
    },
    "source_set_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "confirmed_plan_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "binding_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "server_payment_receipt_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "remaining_compute_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "candidate_output_allowed": {
      "type": "boolean"
    }
  },
  "required": [
    "protocol_version",
    "session_id",
    "task_id",
    "run_id",
    "attempt_id",
    "fence",
    "phase",
    "skill_manifest_sha256",
    "skill_preload_receipt_sha256",
    "input_manifest_path",
    "source_set_sha256",
    "confirmed_plan_sha256",
    "binding_sha256",
    "server_payment_receipt_sha256",
    "remaining_compute_ms",
    "candidate_output_allowed"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {
            "const": "BOOTSTRAP"
          }
        }
      },
      "then": {
        "properties": {
          "task_id": {
            "type": "null"
          },
          "run_id": {
            "type": "null"
          },
          "input_manifest_path": {
            "type": "null"
          },
          "candidate_output_allowed": {
            "const": false
          },
          "skill_preload_receipt_sha256": {
            "type": "null"
          },
          "source_set_sha256": {
            "type": "null"
          },
          "confirmed_plan_sha256": {
            "type": "null"
          },
          "binding_sha256": {
            "type": "null"
          },
          "server_payment_receipt_sha256": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "enum": [
              "ANALYZE",
              "ADJUST"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "run_id": {
            "type": "null"
          },
          "task_id": {
            "type": "string",
            "format": "uuid"
          },
          "skill_preload_receipt_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "input_manifest_path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\]).+$",
            "maxLength": 1000
          },
          "source_set_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "candidate_output_allowed": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "enum": [
              "BATCH",
              "REPAIR"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "run_id": {
            "type": "string",
            "format": "uuid"
          },
          "task_id": {
            "type": "string",
            "format": "uuid"
          },
          "skill_preload_receipt_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "input_manifest_path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\]).+$",
            "maxLength": 1000
          },
          "source_set_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "confirmed_plan_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "binding_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "server_payment_receipt_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "candidate_output_allowed": {
            "const": true
          }
        }
      }
    }
  ]
}

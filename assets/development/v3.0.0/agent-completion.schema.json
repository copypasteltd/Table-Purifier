{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:p07:agent-completion:3",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "const": "P07-AGENT-3"
    },
    "session_id": {
      "type": "string",
      "format": "uuid"
    },
    "outcome": {
      "enum": [
        "SESSION_READY",
        "PLAN_READY",
        "RESULT_READY",
        "FAILED"
      ]
    },
    "skill_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "analysis_scope": {
      "enum": [
        "NONE",
        "FULL",
        "INCOMPLETE"
      ]
    },
    "plan_path": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\]).+$",
          "maxLength": 1000
        },
        {
          "type": "null"
        }
      ]
    },
    "preview_record_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "candidate_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "enum": [
              "standard.xlsx",
              "standard.json",
              "result.xlsx",
              "accepted.csv",
              "result.json",
              "issues.xlsx",
              "provenance.jsonl",
              "validation.json",
              "manifest.json"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\]).+$",
            "maxLength": 1000
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "name",
          "path",
          "sha256",
          "bytes"
        ]
      },
      "maxItems": 9,
      "minItems": 0
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "maxItems": 100,
      "minItems": 0
    },
    "user_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  },
  "required": [
    "protocol_version",
    "session_id",
    "outcome",
    "skill_manifest_sha256",
    "analysis_scope",
    "plan_path",
    "preview_record_count",
    "candidate_files",
    "limitations",
    "user_summary"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "enum": [
              "SESSION_READY",
              "PLAN_READY"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "candidate_files": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "SESSION_READY"
          }
        }
      },
      "then": {
        "properties": {
          "analysis_scope": {
            "const": "NONE"
          },
          "plan_path": {
            "type": "null"
          },
          "preview_record_count": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "PLAN_READY"
          }
        }
      },
      "then": {
        "properties": {
          "analysis_scope": {
            "const": "FULL"
          },
          "plan_path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\]).+$",
            "maxLength": 1000
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "RESULT_READY"
          }
        }
      },
      "then": {
        "properties": {
          "candidate_files": {
            "minItems": 9,
            "maxItems": 9
          }
        }
      }
    }
  ]
}

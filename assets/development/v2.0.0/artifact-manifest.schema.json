{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "const": "P07-ARTIFACT-1"
    },
    "artifact_set_id": {
      "type": "string",
      "format": "uuid"
    },
    "task_id": {
      "type": "string",
      "format": "uuid"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "result_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "binding_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_set_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "quality_status": {
      "type": "string",
      "enum": [
        "PASSED",
        "NEEDS_REVIEW",
        "BLOCKED"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "standard.xlsx",
              "standard.json",
              "result.xlsx",
              "accepted.csv",
              "result.json",
              "issues.xlsx",
              "provenance.jsonl",
              "validation.json"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "media_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "name",
          "sha256",
          "bytes",
          "media_type"
        ]
      },
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total_candidates": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "accepted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "needs_review": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "excluded": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "total_candidates",
        "accepted",
        "needs_review",
        "excluded"
      ]
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parser": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "ocr": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "rule": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "exporter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "parser",
        "ocr",
        "model",
        "prompt",
        "rule",
        "exporter"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1500
      }
    }
  },
  "required": [
    "format_version",
    "artifact_set_id",
    "task_id",
    "run_id",
    "result_version",
    "binding_sha256",
    "source_set_sha256",
    "quality_status",
    "created_at",
    "expires_at",
    "files",
    "counts",
    "versions",
    "limitations"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:p07:artifact-manifest:1",
  "description": "Eight payload files only. Check unique names/count sum/readback in domain validator. Manifest own hash returned via API; schema does not prove file facts."
}

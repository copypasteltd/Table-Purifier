{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:p07:agent-completion:2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "const": "P07-AGENT-2"
    },
    "attempt_id": {
      "type": "string",
      "format": "uuid"
    },
    "input_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_set_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "binding_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "outcome": {
      "enum": [
        "PREFLIGHT_READY",
        "PROPOSAL_READY",
        "RESULT_READY",
        "FAILED"
      ]
    },
    "analysis_scope": {
      "enum": [
        "PARTIAL",
        "FULL",
        "INCOMPLETE"
      ]
    },
    "schema_status": {
      "enum": [
        "NOT_REQUIRED_YET",
        "PARTIAL_DRAFT",
        "FULL_DRAFT",
        "ADOPTED"
      ]
    },
    "candidate_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\]).+$",
            "maxLength": 1000,
            "description": "Workspace-relative path. Realpath, ACL, ADS and reparse-point checks remain mandatory."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes",
          "role"
        ]
      },
      "minItems": 0,
      "maxItems": 200
    },
    "coverage_ledger_path": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\]).+$",
          "maxLength": 1000,
          "description": "Workspace-relative path. Realpath, ACL, ADS and reparse-point checks remain mandatory."
        },
        {
          "type": "null"
        }
      ]
    },
    "proposal_path": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\]).+$",
          "maxLength": 1000,
          "description": "Workspace-relative path. Realpath, ACL, ADS and reparse-point checks remain mandatory."
        },
        {
          "type": "null"
        }
      ]
    },
    "preview_path": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\]).+$",
          "maxLength": 1000,
          "description": "Workspace-relative path. Realpath, ACL, ADS and reparse-point checks remain mandatory."
        },
        {
          "type": "null"
        }
      ]
    },
    "issues_path": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\]).+$",
          "maxLength": 1000,
          "description": "Workspace-relative path. Realpath, ACL, ADS and reparse-point checks remain mandatory."
        },
        {
          "type": "null"
        }
      ]
    },
    "user_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "minItems": 0,
      "maxItems": 200
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "protocol_version",
    "attempt_id",
    "input_manifest_sha256",
    "source_set_sha256",
    "binding_sha256",
    "outcome",
    "analysis_scope",
    "schema_status",
    "candidate_files",
    "coverage_ledger_path",
    "proposal_path",
    "preview_path",
    "issues_path",
    "user_summary",
    "limitations",
    "error_code"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "PROPOSAL_READY"
          }
        }
      },
      "then": {
        "properties": {
          "analysis_scope": {
            "const": "FULL"
          },
          "schema_status": {
            "const": "FULL_DRAFT"
          },
          "proposal_path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\]).+$",
            "maxLength": 1000,
            "description": "Workspace-relative path. Realpath, ACL, ADS and reparse-point checks remain mandatory."
          },
          "preview_path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\]).+$",
            "maxLength": 1000,
            "description": "Workspace-relative path. Realpath, ACL, ADS and reparse-point checks remain mandatory."
          },
          "coverage_ledger_path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\]).+$",
            "maxLength": 1000,
            "description": "Workspace-relative path. Realpath, ACL, ADS and reparse-point checks remain mandatory."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "RESULT_READY"
          }
        }
      },
      "then": {
        "properties": {
          "analysis_scope": {
            "const": "FULL"
          },
          "schema_status": {
            "const": "ADOPTED"
          },
          "binding_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "candidate_files": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\]).+$",
                  "maxLength": 1000,
                  "description": "Workspace-relative path. Realpath, ACL, ADS and reparse-point checks remain mandatory."
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "role": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              },
              "required": [
                "path",
                "sha256",
                "bytes",
                "role"
              ]
            },
            "minItems": 9,
            "maxItems": 200
          },
          "coverage_ledger_path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\]).+$",
            "maxLength": 1000,
            "description": "Workspace-relative path. Realpath, ACL, ADS and reparse-point checks remain mandatory."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "FAILED"
          }
        }
      },
      "then": {
        "properties": {
          "error_code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    }
  ],
  "description": "Untrusted Agent completion envelope. SDK/CLI structured output plus this schema are not evidence of business success. Host must verify files, scope, authority and content."
}
